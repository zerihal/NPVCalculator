<UserControl x:Class="NPV_Calculator_UI.Controls.CalcTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPV_Calculator_UI.Controls"
             xmlns:vm="clr-namespace:NPV_Calculator_UI.ViewModels"
             xmlns:util="clr-namespace:NPV_Calculator_UI.Util"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CalcTableViewModel}">
    <UserControl.Resources>
        <util:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <ContextMenu x:Key="ItemContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Delete"
                      Command="{Binding Source={StaticResource Proxy}, Path=Data.RemoveNcf}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Image Source="../Images/Delete.png" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Black"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" SharedSizeGroup="ColumnSize"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnSize"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnSize"/>
            </Grid.ColumnDefinitions>
            <Border Padding="10,5" BorderThickness="1" Grid.Column="0">
                <TextBlock Text="NCF"/>
            </Border>
            <Border Padding="10,5" BorderThickness="0,1,0,1" Grid.Column="1">
                <TextBlock Text="Discount Factor"/>
            </Border>
            <Border Padding="10,5" BorderThickness="1" Grid.Column="2">
                <TextBlock Text="NPV"/>
            </Border>
        </Grid>
        <ItemsControl ItemsSource="{Binding Values}" Grid.IsSharedSizeScope="True" HorizontalAlignment="Center" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ContextMenu="{StaticResource ItemContextMenu}">
                        <Grid.Resources>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Black"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" SharedSizeGroup="ColumnSize"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnSize"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnSize"/>
                        </Grid.ColumnDefinitions>
                        <Border Padding="10,5" BorderThickness="1,0,1,1" Grid.Column="0">
                            <TextBox Text="{Binding NCFValue}" BorderThickness="0" ContextMenu="{StaticResource ItemContextMenu}"/>
                        </Border>
                        <Border Padding="10,5" BorderThickness="0,0,0,1" Grid.Column="1">
                            <TextBlock Text="{Binding DiscountFactor}"/>
                        </Border>
                        <Border Padding="10,5" BorderThickness="1,0,1,1" Grid.Column="2">
                            <TextBlock Text="{Binding NPV}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="2" Margin="0,10,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="Green" BorderThickness="1" CornerRadius="5" Grid.Column="0" HorizontalAlignment="Left">
                <StackPanel Margin="5" Orientation="Horizontal">
                    <local:NumericTextBox x:Name="NewNcfTextBox" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Add NCF" Command="{Binding AddNcf}" CommandParameter="{Binding Text, ElementName=NewNcfTextBox}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalNpvIrrLabel}" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalNpvIrr}" FontWeight="Bold" Margin="5,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="NPV_Calculator_UI.CalcUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPV_Calculator_UI"
        mc:Ignorable="d"
        Title="NPV Calculator" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border CornerRadius="5" BorderThickness="1" BorderBrush="DarkGray" HorizontalAlignment="Stretch" Margin="5">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,0,0,5" 
                           Text="Calculator Settings" 
                           HorizontalAlignment="Center" 
                           FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="5,0"/>
                        </Style>
                    </StackPanel.Resources>
                    
                    <TextBlock Text="Discount Rate (%):" Margin="5,0"/>
                    <TextBox Margin="5,0" Width="30"/>
                    <TextBlock Text="Discount factor DP:" Margin="5,0"/>
                    <TextBox Margin="5,0" Width="20"/>
                    <TextBlock Text="NPV DP:"/>
                    <TextBox Margin="5,0" Width="20"/>
                    <CheckBox Content="Round discount factor in calculation" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" CornerRadius="5" BorderThickness="1" BorderBrush="DarkGray" HorizontalAlignment="Stretch" Margin="5,0,5,5">
            
        </Border>
    </Grid>
</Window>
